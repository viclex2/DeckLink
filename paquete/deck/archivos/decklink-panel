#!/bin/bash
# Panel de DeckLink en la Steam Deck: estado y opciones (lo abre el icono del escritorio)

DEST="$HOME/.local/share/decklink"
WIFI="$HOME/.config/decklink/wifi"
ICONO="$DEST/decklink.svg"
. "$DEST/dialogos.sh"
REPO="viclex2/DeckLink"

# Busca en GitHub una versión más nueva y, si el usuario quiere, la instala
actualizar() {
    local ver tmp res tag url
    ver=$(cat "$DEST/version" 2>/dev/null)
    res=$(curl -fsSL --max-time 30 -H 'Accept: application/vnd.github+json' \
          "https://api.github.com/repos/$REPO/releases?per_page=20" 2>/dev/null | python3 -c '
import json, re, sys
actual = sys.argv[1].split()
def v(t): return ([int(x) for x in re.findall(r"\d+", t)] + [0, 0, 0])[:3]
va = v(actual[0]) if actual else [0, 0, 0]
pruebas = len(actual) > 1
mejor = None
try:
    datos = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for r in datos:
    if r.get("draft"): continue
    pre = bool(r.get("prerelease"))
    if pre and not pruebas: continue
    url = [a["browser_download_url"] for a in r.get("assets", []) if a.get("name") == "DeckLink-SteamDeck.zip"]
    if not url: continue
    x = v(r["tag_name"])
    if x > va or (x == va and pruebas and not pre):
        if mejor is None or x > mejor[0]: mejor = (x, r["tag_name"], url[0])
print("" if mejor is None else mejor[1] + " " + mejor[2])
' "$ver")
    if [ $? -ne 0 ]; then
        dlg_error "No he podido mirar si hay versiones nuevas. ¿Está la Deck conectada a internet?"
        return
    fi
    if [ -z "$res" ]; then
        dlg_info "Ya tienes la última versión de DeckLink (${ver:-desconocida})."
        return
    fi
    tag=${res%% *}; url=${res#* }
    dlg_si_no "Hay una versión nueva de DeckLink: $tag
(tienes la ${ver:-desconocida})

¿Descargarla e instalarla ahora? Te pedirá la contraseña, como la primera vez.
Recuerda actualizar también el PC y el móvil (se actualizan solos al abrirlos)." || return
    tmp=$(mktemp -d)
    if ! curl -fsSL --max-time 300 -o "$tmp/d.zip" "$url" || \
       ! python3 -c 'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])' "$tmp/d.zip" "$tmp"; then
        rm -rf "$tmp"
        dlg_error "No se ha podido descargar la versión nueva. Inténtalo otra vez más tarde."
        return
    fi
    chmod +x "$tmp/DeckLink-SteamDeck/Instalar DeckLink" "$tmp/DeckLink-SteamDeck/archivos/"* 2>/dev/null
    exec "$tmp/DeckLink-SteamDeck/Instalar DeckLink"
}

while true; do
    activo=$(systemctl --user is-active app-io.github.viclex2.decklink.service 2>/dev/null)
    udc=$(ls /sys/class/udc 2>/dev/null | head -n1)
    vel=""
    [ -n "$udc" ] && vel=$(cat "/sys/class/udc/$udc/current_speed" 2>/dev/null)

    if [ -z "$udc" ]; then
        cable="⚠ Falta activar «USB Dual-Role Device = DRD» en la BIOS de la Deck."
    else
        case "$vel" in
            super-speed*) cable="✔ Cable conectado al portátil (USB 3: máxima calidad, sin compresión)." ;;
            high-speed)   cable="✔ Cable conectado al portátil (USB 2: imagen comprimida)." ;;
            *)            cable="Cable no conectado. Conecta la Deck al portátil con un cable USB." ;;
        esac
    fi
    if [ "$activo" = "active" ]; then
        estado="DeckLink está ACTIVADO y esperando al portátil (también en modo juego)."
        conmutar="Desactivar DeckLink"
    else
        estado="DeckLink está DESACTIVADO."
        conmutar="Activar DeckLink"
    fi

    if [ -s "$WIFI" ]; then
        wifi_txt="📶 Wifi ACTIVADO — PIN: $(cat "$WIFI")  (escríbelo en la app la primera vez)"
        wifi_op="Desactivar la conexión por wifi"
    else
        wifi_txt="Wifi desactivado (actívalo para usar Android, Quest o un PC sin cable)"
        wifi_op="Activar la conexión por wifi"
    fi

    op=$(dlg_menu "$estado

$cable
$wifi_txt

En el portátil, haz doble clic en el icono DeckLink.
Para salir de la pantalla completa en el portátil: Ctrl + Alt + Mayús + Q" \
        conmutar "$conmutar" \
        wifi "$wifi_op" \
        actualizar "Buscar actualizaciones (tienes la $(cat "$DEST/version" 2>/dev/null || echo '?'))" \
        permiso "Volver a pedir permiso para compartir la pantalla" \
        desinstalar "Desinstalar DeckLink") || exit 0
    [ -n "$op" ] || exit 0

    case "$op" in
        conmutar)
            if [ "$activo" = "active" ]; then
                systemctl --user disable --now app-io.github.viclex2.decklink.service >/dev/null 2>&1
            else
                systemctl --user enable --now app-io.github.viclex2.decklink.service >/dev/null 2>&1
            fi ;;
        wifi)
            if [ -s "$WIFI" ]; then
                rm -f "$WIFI"
                dlg_info "Conexión por wifi desactivada. Solo se podrá conectar por cable USB."
            else
                mkdir -p "$(dirname "$WIFI")"
                pin=$(printf '%04d' $(( $(od -An -N2 -tu2 /dev/urandom) % 10000 )))
                ( umask 077; echo "$pin" > "$WIFI" )
                dlg_info "Conexión por wifi ACTIVADA.

Tu PIN es:   $pin

La Steam Deck y el móvil, las Quest o el PC tienen que estar en la misma red wifi. Abre DeckLink allí y escribe este PIN la primera vez.

Puedes volver a verlo aquí cuando quieras."
            fi ;;
        permiso)
            "$DEST/decklink-deck" --olvidar >/dev/null 2>&1
            systemctl --user restart app-io.github.viclex2.decklink.service
            dlg_info "Hecho. La próxima vez que conectes el portátil en modo escritorio, la Deck te volverá a preguntar qué pantalla compartir." ;;
        actualizar)
            actualizar ;;
        desinstalar)
            exec "$DEST/desinstalar.sh" ;;
    esac
done
