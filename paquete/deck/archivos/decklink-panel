#!/bin/bash
# Panel de DeckLink en la Steam Deck: estado y opciones (lo abre el icono del escritorio)

DEST="$HOME/.local/share/decklink"
ICONO="$DEST/decklink.svg"
. "$DEST/dialogos.sh"

while true; do
    activo=$(systemctl --user is-active decklink.service 2>/dev/null)
    udc=$(ls /sys/class/udc 2>/dev/null | head -n1)
    vel=""
    [ -n "$udc" ] && vel=$(cat "/sys/class/udc/$udc/current_speed" 2>/dev/null)

    if [ -z "$udc" ]; then
        cable="⚠ Falta activar «USB Dual-Role Device = DRD» en la BIOS de la Deck."
    else
        case "$vel" in
            super-speed*) cable="✔ Cable conectado al portátil (USB 3: máxima calidad, sin compresión)." ;;
            high-speed)   cable="✔ Cable conectado al portátil (USB 2: imagen comprimida)." ;;
            *)            cable="Cable no conectado. Conecta la Deck al portátil con un cable USB." ;;
        esac
    fi
    if [ "$activo" = "active" ]; then
        estado="DeckLink está ACTIVADO y esperando al portátil (también en modo juego)."
        conmutar="Desactivar DeckLink"
    else
        estado="DeckLink está DESACTIVADO."
        conmutar="Activar DeckLink"
    fi

    op=$(dlg_menu "$estado

$cable

En el portátil, haz doble clic en el icono DeckLink.
Para salir de la pantalla completa en el portátil: Ctrl + Alt + Mayús + Q" \
        conmutar "$conmutar" \
        permiso "Volver a pedir permiso para compartir la pantalla" \
        desinstalar "Desinstalar DeckLink") || exit 0
    [ -n "$op" ] || exit 0

    case "$op" in
        conmutar)
            if [ "$activo" = "active" ]; then
                systemctl --user disable --now decklink.service >/dev/null 2>&1
            else
                systemctl --user enable --now decklink.service >/dev/null 2>&1
            fi ;;
        permiso)
            "$DEST/decklink-deck" --olvidar >/dev/null 2>&1
            systemctl --user restart decklink.service
            dlg_info "Hecho. La próxima vez que conectes el portátil en modo escritorio, la Deck te volverá a preguntar qué pantalla compartir." ;;
        desinstalar)
            exec "$DEST/desinstalar.sh" ;;
    esac
done
